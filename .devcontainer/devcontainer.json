        "baseImage": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04@sha256:d94c97dd9cacf183d0a6fd12a8e87b526e9e928307674ae9c94139139c0c6eae",
        "sourceSHA256": "sha256:dc2dd78fe9d8f0865d5718ac32be37e72fb89e584629fb5d2dcd2b83820848a5",
        "archiveSHA256": "sha256:893b3a3003c0a6c8102c8c0cb4735220ad1b59c8390f16402c0b0eedae515779",
        "archiveParts": 3,
