        "baseImage": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04@sha256:d94c97dd9cacf183d0a6fd12a8e87b526e9e928307674ae9c94139139c0c6eae",
        "sourceSHA256": "sha256:b67bf0f335b2b83a531c359b1a3645cb2c28f592c0ec19656c48d28686465d4c",
        "archiveSHA256": "sha256:da7011f0eda79f05158b850f2be7cd0e2357f029f7dee7eb86321afad5fc7ae3",
        "archiveParts": 4,
        "dockerfileSHA256": "sha256:8cd6bf99dcff93ad35b11b26e789eac02426ef3dc3a31fd8d5dfc03eb99ed56a"
      }
    },
    "vscode": {
      "extensions": [
        "GitHub.vscode-pull-request-github",
        "aquasecurity.trivy-vulnerability-scanner",
        "davidanson.vscode-markdownlint",
