# Go tests on Windows runners hash and byte-compare checked-out files, so every
# text file keeps LF bytes on every platform. Binary files are detected by Git.
* text=auto eol=lf
experiments/workstation/fixture-026/configs/rsd-t02-arm-bank.json text eol=lf
experiments/workstation/fixture-026/rsd-t02-arm-bank.mjs text eol=lf
experiments/workstation/fixture-026/rsd-t02-contract.mjs text eol=lf
experiments/workstation/fixture-026/rsd-t02-isolated-policy.mjs text eol=lf
experiments/workstation/fixture-026/rsd-t02-policy-worker.mjs text eol=lf
experiments/workstation/fixture-026/rsd-t02-policy-bundle.inventory.json text eol=lf
experiments/workstation/fixture-026/policy-bundles/*.js text eol=lf
experiments/workstation/fixture-026/** text eol=lf
experiments/workstation/lib/checkpoint-ledger.mjs text eol=lf
experiments/workstation/candidate-010/seeds/seed-release-artifacts.schema.json text eol=lf
tooling/clrs-generator/*.json text eol=lf
tooling/clrs-generator/*.md text eol=lf
tooling/clrs-generator/Dockerfile text eol=lf
tooling/clrs-generator/.dockerignore text eol=lf
tooling/clrs-generator/uv.lock text eol=lf
research/engineering-relations.json text eol=lf
sources/** -text
LICENSE text eol=lf
LICENSES/*.txt text eol=lf
THIRD_PARTY_NOTICES.txt text eol=lf

# BEGIN praetor managed attributes (praetorctl adopt)
# praetorctl audit hashes these files; keep their checkout bytes the same on every platform.
.devcontainer/Dockerfile.praetor text eol=lf
tools/figures/** text eol=lf
docs/figures/*.ts text eol=lf
docs/assets/figures/* text eol=lf
tools/figures/third_party/interfig/upstream/** -text
# END praetor managed attributes
