      "oneOf": [
        { "required": ["trainable_state_space_estimator_exists"], "not": { "required": ["trainable_gru_style_estimator_exists"] } },
        { "required": ["trainable_gru_style_estimator_exists"], "not": { "required": ["trainable_state_space_estimator_exists"] } }
      ]
    },
