{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://20-watts-was-enough.local/schemas/workstation-manifest.schema.json",
  "title": "20 Watts Was Enough workstation experiment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifact",
    "readiness",
    "distribution",
    "command",
    "environment",
    "hardware",
    "seeds",
    "data",
    "outputs",
    "implementation",
    "energy",
    "resume",
    "promotion_evidence"
  ],
  "properties": {
    "schema": { "const": 1 },
    "artifact": { "type": "string", "pattern": "^(candidate|fixture)-[0-9]{3}$" },
    "readiness": {
      "enum": ["scaffold", "smoke-ready", "workstation-ready"]
    },
    "distribution": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "runtime_class", "authority"],
          "properties": {
            "state": { "const": "source-only" },
            "runtime_class": { "const": "node-source" },
            "authority": { "const": "NO_RESULT" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "runtime_class", "image", "platforms", "build_context", "dockerfile", "authority"],
          "properties": {
            "state": { "const": "release-image" },
            "runtime_class": { "enum": ["transitional-node", "node-python"] },
            "image": { "type": "string", "pattern": "^ghcr\\.io/lusoris/20-watts-was-enough-(?:candidate|fixture)-[0-9]{3}$" },
            "platforms": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^linux/(?:amd64|arm64)$" }
            },
            "build_context": { "enum": ["closed-go-package", "repository-root"] },
            "dockerfile": { "$ref": "#/$defs/repositoryPath" },
            "authority": { "const": "NO_RESULT" }
          }
        }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prepare", "smoke", "run", "analyze", "validate"],
      "properties": {
        "prepare": { "type": "string", "minLength": 1 },
        "smoke": { "type": "string", "minLength": 1 },
        "run": { "type": "string", "minLength": 1 },
        "analyze": { "type": "string", "minLength": 1 },
        "validate": { "type": "string", "minLength": 1 }
      }
    },
    "environment": {
      "type": "object",
      "required": ["runtime", "lockfiles"],
      "properties": {
        "runtime": { "type": "string", "minLength": 1 },
        "lockfiles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "hardware": {
      "type": "object",
      "required": ["smoke", "workstation"],
      "properties": {
        "smoke": { "type": "object" },
        "workstation": { "type": "object" }
      }
    },
    "seeds": {
      "type": "object",
      "required": ["development", "confirmation", "held_out"],
      "properties": {
        "development": { "type": "string", "minLength": 1 },
        "confirmation": { "type": "string", "minLength": 1 },
        "held_out": { "type": "string", "minLength": 1 }
      }
    },
    "seed_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_schema",
        "artifact_schema_sha256",
        "operator_contract_version",
        "release_plan_contract_version",
        "reveal_attestation_contract_version",
        "required_generation_method",
        "require_claim_eligible",
        "require_joint_release_set"
      ],
      "properties": {
        "artifact_schema": { "$ref": "#/$defs/repositoryPath" },
        "artifact_schema_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "operator_contract_version": { "type": "string", "minLength": 1 },
        "release_plan_contract_version": { "type": "string", "minLength": 1 },
        "reveal_attestation_contract_version": { "type": "string", "minLength": 1 },
        "required_generation_method": { "const": "system-cryptographic-entropy-v1" },
        "require_claim_eligible": { "const": true },
        "require_joint_release_set": { "const": true }
      }
    },
    "data": {
      "type": "object",
      "required": ["generator"],
      "properties": {
        "generator": { "type": "string", "minLength": 1 },
        "full_profile": { "type": "string", "minLength": 1 },
        "external": { "type": "array" }
      }
    },
    "outputs": {
      "type": "object",
      "required": ["directory", "schema", "append_only", "hash_chain"],
      "properties": {
        "directory": { "type": "string", "minLength": 1 },
        "schema": { "type": "string", "minLength": 1 },
        "append_only": { "const": true },
        "hash_chain": { "type": "boolean" }
      }
    },
    "implementation": {
      "type": "object",
      "required": ["entrypoint", "tests", "full_tests"],
      "properties": {
        "entrypoint": { "type": "string", "minLength": 1 },
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "full_tests": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "energy": {
      "type": "object",
      "required": ["mode", "required"],
      "properties": {
        "mode": { "type": "string" },
        "required": { "type": "boolean" },
        "provider_config": { "type": "string" },
        "applicability": {
          "enum": ["measured-endpoint", "not-applicable-to-scoped-claim"]
        },
        "energy_conclusion_allowed": { "type": "boolean" },
        "not_applicable_reason": { "type": "string", "minLength": 1 },
        "scope_binding": { "type": "string", "minLength": 1 }
      }
    },
    "resume": {
      "type": "object",
      "required": ["supported"],
      "properties": {
        "supported": { "type": "boolean" }
      }
    },
    "promotion_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence_path",
        "promotion_validation_receipt_path",
        "run_directory",
        "release_root",
        "release_path",
        "energy_assignments_path",
        "disjoint_seed_pack_paths"
      ],
      "properties": {
        "status": { "enum": ["pending", "present"] },
        "evidence_path": { "$ref": "#/$defs/repositoryPath" },
        "promotion_validation_receipt_path": { "$ref": "#/$defs/repositoryPath" },
        "run_directory": { "$ref": "#/$defs/repositoryPath" },
        "release_root": { "$ref": "#/$defs/repositoryPath" },
        "release_path": { "$ref": "#/$defs/repositoryPath" },
        "energy_assignments_path": { "$ref": "#/$defs/repositoryPath" },
        "disjoint_seed_pack_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        },
        "validator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["module", "export", "test"],
          "properties": {
            "module": { "$ref": "#/$defs/repositoryPath" },
            "export": {
              "type": "string",
              "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
            },
            "test": { "$ref": "#/$defs/repositoryPath" }
          }
        },
        "protocol_eligibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "protocol_version", "claim_scope", "blockers"],
          "properties": {
            "status": { "enum": ["blocked", "reviewed-eligible"] },
            "protocol_version": { "type": "string", "minLength": 1 },
            "claim_scope": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^C-[0-9]{3,4}$" }
            },
            "blockers": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "review_path": { "$ref": "#/$defs/repositoryPath" },
            "review_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\.\\.).+$"
    }
  }
}
